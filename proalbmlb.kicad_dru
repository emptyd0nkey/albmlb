(version 1)

# PCBWay Custom DRC for KiCad 8
# Stackup: 6 layers (2 oz outer, 1 oz inner)

# ----------------------------------- Trace Width & Spacing ----------------------------------

(rule "Minimum Trace Width and Spacing (Outer Layers)"
   (layer outer)
   (constraint track_width (min 0.2mm))
   (constraint clearance (min 0.25mm))
   (condition "A.type == 'track'"))

(rule "Minimum Trace Width and Spacing (Inner Layers)"
   (layer inner)
   (constraint track_width (min 0.2mm))
   (constraint clearance (min 0.2mm))
   (condition "A.type == 'track'"))

(rule "Relaxed Clearance Outer Layers"
   (layer outer)
   (constraint clearance (min 0.2mm))
   (condition "A.type == 'track' || A.type == 'zone'"))

# ----------------------------------- Vias & Drill Sizes -------------------------------------

(rule "Mechanical Drill Size Limits"
   (constraint hole_size (min 0.15mm) (max 6.3mm)))

(rule "Minimum Via Diameter and Hole Size"
   (constraint hole_size (min 0.25mm))
   (constraint via_diameter (min 0.55mm))
   (condition "A.type == 'via'"))

(rule "PTH Hole Size Limits"
   (constraint hole_size (min 0.25mm) (max 6.35mm))
   (condition "A.type == 'pad' && A.isPlated()"))

(rule "Minimum NPTH Hole Size"
   (constraint hole_size (min 0.5mm))
   (condition "A.type == 'pad' && !A.isPlated()"))

(rule "Plated Pad Annular Width"
   (constraint hole_size (min 0.25mm))
   (constraint annular_width (min 0.15mm))
   (condition "A.type == 'pad' && A.isPlated()"))

#(rule "Enforce Safe Annular Ring"
#   (constraint annular_width (min 0.2mm))
#   (condition "A.type == 'via' || A.type == 'pad'"))

(rule "Minimum Castellated Hole Size"
   (constraint hole_size (min 0.6mm))
   (condition "A.type == 'pad' && A.Fabrication_Property == 'castellated'"))

# Slotted Hole Checks (KiCad 8 valid expression)
(rule "Min Plated Slot Width"
   (constraint hole_size (min 0.5mm))
   (condition "A.type == 'pad' && A.hole_size_x != A.hole_size_y && A.isPlated()"))

(rule "Min Non-Plated Slot Width"
   (constraint hole_size (min 0.8mm))
   (condition "A.type == 'pad' && A.hole_size_x != A.hole_size_y && !A.isPlated()"))

# ----------------------------------- Clearances & Spacing -----------------------------------

(rule "Minimum Drill Spacing"
   (constraint hole_to_hole (min 0.3mm)))

(rule "Hole to Hole Clearance (Different Nets)"
   (constraint hole_to_hole (min 0.5mm))
   (condition "A.net != B.net"))

(rule "Copper to Hole Edge Clearance"
   (constraint hole_clearance (min 0.3mm))
   (condition "A.type == 'track' || A.type == 'zone'"))

(rule "Via to Track Clearance"
   (constraint hole_clearance (min 0.254mm))
   (condition "A.type == 'via' && B.type == 'track'"))

(rule "Via to Via Clearance (Same Net)"
   (constraint hole_to_hole (min 0.254mm))
   (condition "A.type == 'via' && B.type == 'via' && A.net == B.net"))

(rule "Pad to Pad Clearance (With Hole, Different Nets)"
   (constraint hole_to_hole (min 0.5mm))
   (condition "A.type == 'pad' && B.type == 'pad' && A.net != B.net"))

(rule "Pad to Pad Clearance (SMD Surface, Different Nets)"
   (constraint clearance (min 0.2mm))
   (condition "A.type == 'pad' && B.type == 'pad' && A.net != B.net"))

(rule "NPTH to Track Clearance"
   (constraint hole_clearance (min 0.254mm))
   (condition "A.type == 'pad' && !A.isPlated() && B.type == 'track'"))

(rule "NPTH to General Copper Clearance"
   (constraint hole_clearance (min 0.20mm))
   (condition "A.type == 'pad' && !A.isPlated() && B.type != 'track'"))

(rule "PTH to Track Clearance"
   (constraint hole_clearance (min 0.33mm))
   (condition "A.type == 'pad' && A.isPlated() && B.type == 'track'"))

(rule "Pad to Track Clearance"
   (constraint clearance (min 0.2mm))
   (condition "A.type == 'pad' && B.type == 'track'"))

# ----------------------------------- Edge Clearances ----------------------------------------

(rule "Trace to Board Edge Clearance"
   (constraint edge_clearance (min 0.3mm))
   (condition "A.type == 'track'"))

# ----------------------------------- Silkscreen ---------------------------------------------

(rule "Silkscreen Minimum Text Size"
   (layer "?.Silkscreen")
   (constraint text_thickness (min 0.15mm))
   (constraint text_height (min 0.8mm)))

(rule "Pad to Silkscreen Clearance"
   (layer outer)
   (constraint silk_clearance (min 0.15mm))
   (condition "A.type == 'pad' && (B.type == 'text' || B.type == 'graphic')"))

# ----------------------------------- Courtyard Exclusions -----------------------------------

(rule "Test Point Courtyard Exclusion"
   (constraint courtyard_clearance (min -1mm))
   (condition "A.Reference == 'TP*'"))

(rule "Fiducial Courtyard Exclusion"
   (constraint courtyard_clearance (min -1mm))
   (condition "A.Reference == 'FM*'"))
